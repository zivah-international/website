{
  "name": "zivah-international-website",
  "version": "1.0.0",
  "description": "Sitio web corporativo para ZIVAH International S.A. - Exportadores premium de productos ecuatorianos",
  "main": "src/app/page.tsx",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "type-check": "npx tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "prepare": "npx --yes husky || echo 'Husky setup skipped'",
    "postinstall": "echo 'Postinstall completed'"
  },
  "keywords": [
    "zivah",
    "international",
    "ecuador",
    "export",
    "seafood",
    "fruits",
    "coffee",
    "shrimp",
    "aquaculture",
    "miami"
  ],
  "author": "ZIVAH International S.A.",
  "license": "Apache-2.0",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
