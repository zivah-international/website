    "nodemailer": "^7.0.11",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.69.0",
    "react-select": "^5.10.2",
    "sonner": "^2.0.7",
