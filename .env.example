# Database
DATABASE_URL=""
# MySQL (use only after completing migration in DATABASE_SETUP.md)
# DATABASE_URL="mysql://username:password@localhost:3306/zivah_international"
DB_POOL_SIZE="50"  # Connection pool size (increase for production)

# NextAuth.js
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Email Configuration
EMAIL_FROM="noreply@zivahinternational.com"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"

# SMTP Configuration (Alternative - can use different SMTP server)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-email@gmail.com"
SMTP_PASS="your-smtp-password"

# Google Analytics Configuration
# Replace with your actual Google Analytics 4 Measurement ID
# You can find this in your GA4 property settings
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Optional: Google Ads Conversion IDs (replace with actual IDs for conversion tracking)
GOOGLE_ADS_CONVERSION_ID_QUOTE="AW-XXXXXXXXX/XXXXXXXXXXX"
GOOGLE_ADS_CONVERSION_ID_CONTACT="AW-XXXXXXXXX/YYYYYYYYYYY"
GOOGLE_ADS_CONVERSION_ID_NEWSLETTER="AW-XXXXXXXXX/ZZZZZZZZZZZ"
GOOGLE_ADS_CONVERSION_ID_DOWNLOAD="AW-XXXXXXXXX/WWWWWWWWWWW"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Security Settings
RATE_LIMIT_MAX="1000"  # Maximum requests per time window
RATE_LIMIT_WINDOW="900000"  # Time window in milliseconds (15 minutes)

# File Upload Settings
NEXT_PUBLIC_UPLOAD_MAX_SIZE="10485760"  # Max file size in bytes (10MB)
UPLOAD_DIR="./tmp/uploads"  # Upload directory path

# FTP Deployment Configuration
FTP_HOST="ftp.zivahinternational.com"
FTP_USER="zivahint"
FTP_PASSWORD="your-ftp-password-here"
FTP_PATH="/public_html/nextjs"

# Optional: Server Configuration (usually auto-detected)
# HOST="localhost"
# PORT="3000"
# NODE_ENV="development"

# Optional: Separate Database Connection Variables (if not using DATABASE_URL)
# DB_HOST="localhost"
# DB_PORT="3306"
# DB_NAME="zivah_international"
# DB_USER="root"
# DB_PASSWORD=""
