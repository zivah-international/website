# ===========================================
# ZIVAH International - Environment Variables
# ===========================================

# --------------------------
# DATABASE (Required)
# --------------------------
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/database"  # For migrations/seeds
DB_POOL_SIZE="20"  # Connection pool size (Supabase pooler recommended: 20)

# --------------------------
# SUPABASE (Required)
# --------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="your-anon-key"
SUPABASE_SECRET_KEY="your-service-role-key"

# --------------------------
# EMAIL (Required)
# --------------------------
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="noreply@zivahinternational.com"
BUSINESS_EMAIL="info@zivahinternational.com"  # BCC for quote notifications

# --------------------------
# TRANSLATION APIs (Optional - pick one)
# --------------------------
# OPENAI_API_KEY="sk-..."          # OpenAI for translations
# DEEPL_API_KEY="..."              # DeepL API key
# GOOGLE_TRANSLATE_API_KEY="..."   # Google Translate API key

# --------------------------
# ANALYTICS
# --------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"  # Google Analytics 4

# --------------------------
# FTP DEPLOYMENT (Used by deploy.bat)
# --------------------------
FTP_HOST="ftp.zivahinternational.com"
FTP_USER="zivahint"
FTP_PASSWORD="your-ftp-password"
FTP_PATH="/public_html/app"

# --------------------------
# SEO VERIFICATION (Optional)
# --------------------------
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# NEXT_PUBLIC_BING_VERIFICATION=""
# NEXT_PUBLIC_YANDEX_VERIFICATION=""
# NEXT_PUBLIC_BAIDU_VERIFICATION=""
# NEXT_PUBLIC_PINTEREST_VERIFICATION=""

# --------------------------
# SERVER (Optional - auto-detected)
# --------------------------
# NODE_ENV="development"
# HOST="localhost"
# PORT="3000"
